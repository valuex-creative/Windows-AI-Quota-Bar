<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>QuotaBar</AssemblyName>
    <AssemblyTitle>Windows AI Quota Bar</AssemblyTitle>
    <RootNamespace>QuotaBar.App</RootNamespace>
    <ApplicationIcon>Assets\quotabar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <ProjectReference Include="..\QuotaBar.Core\QuotaBar.Core.csproj" />
    <ProjectReference Include="..\QuotaBar.Cli\qb.csproj" />
    <Resource Include="Assets\quotabar.ico" />
    <EmbeddedResource Include="Lang\*.json" LogicalName="Lang.%(Filename).json" />
    <Resource Include="Assets\icons\*.svg" />
    <Resource Include="Assets\icons\*.png" />
    <Content Include="..\..\artifacts\switcher-runtime\**\*" Link="switcher-runtime\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\vendor\CodexAccountSwitcher\LICENSE" Link="licenses\CodexAccountSwitcher-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckSwitcherRuntime" BeforeTargets="PrepareForBuild" Condition="'$(SkipSwitcherRuntimeCheck)' != 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\..\artifacts\switcher-runtime\SwitcherHost.exe')" Text="Run tools/prepare-switcher-runtime.ps1 before building the account-enabled app." />
  </Target>
</Project>
